{
  "kind": "collectionType",
  "collectionName": "newsletter_issues",
  "info": {
    "singularName": "newsletter-issue",
    "pluralName": "newsletter-issues",
    "displayName": "Newsletter Issue",
    "description": "Public newsletter issue pages"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 150
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "issueNumber": {
      "type": "integer",
      "unique": true,
      "min": 1
    },
    "summary": {
      "type": "text",
      "maxLength": 300
    },
    "content": {
      "type": "blocks",
      "required": true
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "publicationDate": {
      "type": "date",
      "required": true
    },
    "regions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::region.region",
      "required": true
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "required": true
    }
  }
}
