# Velza CMS environment template.
#
# Copy this file to .env and replace every placeholder with real local values.
# .env (and any .env.* other than this file) is git-ignored: real secrets and
# credentials belong only there. Never commit working values to this file.

# Server
HOST=0.0.0.0
PORT=1338

# Public URL and reverse proxy (config/server.ts).
# Local development: leave PUBLIC_URL unset and IS_PROXIED=false.
# Behind a reverse proxy: HOST=127.0.0.1 (Strapi reachable only through the proxy), IS_PROXIED=true and
# PUBLIC_URL set to the CMS's https URL (required, https only). The proxy must overwrite
# X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host; Koa trusts them when IS_PROXIED=true.
# PUBLIC_URL=https://cms.example.com   (PLACEHOLDER - the real CMS domain is not decided)
IS_PROXIED=false
# PROXY_MAX_IPS_COUNT=1

# Browser origins allowed to read the Content API (config/middlewares.ts): comma-separated exact
# origins, no "*", no paths. Set per environment; unset = no cross-origin access. https only when
# NODE_ENV=production.
# Local development (integration/tools/dev-site-server.mjs):
CORS_ORIGINS=http://127.0.0.1:8099,http://localhost:8099
# Staging/production: PLACEHOLDERS - the confirmed website origins are not decided, e.g.
# CORS_ORIGINS=https://staging.example.com

# Secrets: generate unique random values for each environment,
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEYS="replace-with-key-1,replace-with-key-2"
API_TOKEN_SALT=replace-with-random-value
ADMIN_JWT_SECRET=replace-with-random-value
TRANSFER_TOKEN_SALT=replace-with-random-value
JWT_SECRET=replace-with-random-value
ENCRYPTION_KEY=replace-with-random-value

# Database: DATABASE_CLIENT is required (postgres, mysql or sqlite).
# For postgres/mysql, HOST, PORT, NAME, USERNAME and PASSWORD are all required;
# startup fails with an error naming any that are missing. DATABASE_URL is not supported.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=replace-with-database-name
DATABASE_USERNAME=replace-with-database-user
DATABASE_PASSWORD=replace-with-database-password
DATABASE_SCHEMA=public

# Optional database settings (defaults shown)
DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_SSL_KEY=
# DATABASE_SSL_CERT=
# DATABASE_SSL_CA=
# DATABASE_SSL_CAPATH=
# DATABASE_SSL_CIPHER=
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# SQLite only (required when DATABASE_CLIENT=sqlite), relative to the project root
# DATABASE_FILENAME=.tmp/data.db

# Optional
# WEBHOOKS_POPULATE_RELATIONS=false
